# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - comma-separated list of allowed origins.
# Local dev: the Vite dev server runs on 3002; `npm run start` (vite preview) uses 3000.
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002

# MongoDB - REQUIRED. There is no default; the server exits if this is missing.
# Local (mongod must be running on 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/skillmatch
# MongoDB Atlas (cloud) - replace the line above with:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skillmatch?retryWrites=true&w=majority

# JWT - REQUIRED. Use a long random string (32+ chars).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# OpenAI - optional. AI features return a clear error if unset.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Production (Render) - set these in Dashboard > Environment, NOT in a file:
#   MONGODB_URI   = your Atlas connection string
#   JWT_SECRET    = long random string
#   NODE_ENV      = production
#   CORS_ORIGIN   = https://your-frontend-domain (no trailing slash)
#   OPENAI_API_KEY (optional)
# ---------------------------------------------------------------------------
